{
	"name": "am-cookies",
	"version": "1.2.15",
	"description": "Simple and versatile GDPR compatible Cookie Compliance Plugin for WordPress.",
	"author": {
		"name": "Aarstein Media",
		"email": "johan@aarstein.media",
		"url": "https://www.aarstein.media",
		"organization": "Aarstein Media"
	},
	"type": "module",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"gdpr",
		"analytics",
		"ga4",
		"tagmanager"
	],
	"homepage": "https://www.aarstein.media/am-cookies",
	"repository": {
		"type": "git",
		"url": "https://github.com/aarsteinmedia/am-cookies"
	},
	"bugs": {
		"url": "https://github.com/aarsteinmedia/am-cookies/issues",
		"email": "johan@aarstein.media"
	},
	"files": [
		"build",
		"includes",
		"scripts",
		"styles/dist",
		"am-cookies.php"
	],
	"main": "build/settings.js",
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.20.4",
		"@eslint/compat": "^2.1.1",
		"@eslint/core": "^1.2.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@regru/eslint-plugin-prefer-early-return": "^1.0.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/eslint-plugin-jsx-a11y": "^6.10.1",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/webpack": "^5.28.5",
		"@types/wordpress__block-editor": "^15.0.6",
		"@wordpress/api-fetch": "^7.55.0",
		"@wordpress/block-editor": "^17.1.0",
		"@wordpress/browserslist-config": "^6.55.0",
		"@wordpress/components": "^40.1.0",
		"@wordpress/element": "^8.7.0",
		"@wordpress/env": "^11.15.0",
		"@wordpress/i18n": "^6.28.0",
		"@wordpress/icons": "^16.0.0",
		"@wordpress/rich-text": "^7.55.0",
		"@wordpress/scripts": "^35.0.0",
		"classnames": "^2.5.1",
		"css-minify": "^2.1.0",
		"eslint": "^10.11.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-no-restricted": "^0.1.2",
		"eslint-plugin-fsecond": "^1.5.0",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-perfectionist": "^5.11.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
		"eslint-plugin-regexp": "^3.3.1",
		"eslint-plugin-sonarjs": "^4.2.1",
		"eslint-plugin-unicorn": "^76.0.0",
		"globals": "^17.12.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.8",
		"react": "^19.3.0",
		"rimraf": "^6.1.3",
		"stylelint": "^17.15.0",
		"stylelint-config-recommended": "^18.0.0",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0"
	},
	"scripts": {
		"predev": "wp-env start --update && open -a Firefox 'http://localhost:8888'",
		"dev": "wp-scripts start --hot --config webpack.config.ts; wp-env stop",
		"css-minify": "css-minify -d styles -o styles/dist",
		"prebuild": "pnpm dep && pnpm css-minify",
		"build": "wp-scripts build --config webpack.config.ts",
		"postbuild": "pnpm svn",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"lint:css": "stylelint **/*.css",
		"lint:css:fix": "stylelint **/*.css --fix",
		"lint:js": "eslint src",
		"lint:js:fix": "eslint src --fix",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"zip": "pnpm build && wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"test:e2e": "wp-scripts test-e2e",
		"test:unit": "wp-scripts test-unit-js",
		"dep": "cp ~/Dev/@aarsteinmedia/am-gdpr/build/unpkg.js ./scripts/am-gdpr.min.js",
		"svn:copy-folders": "cp -R ./build ./includes ./scripts ./styles ./svn/trunk",
		"svn:copy-files": "cp ./am-cookies.php ./LICENSE ./package.json ./readme.txt ./svn/trunk && cp ./blueprint.json ./svn/assets/blueprints",
		"svn": "rimraf ./svn/trunk/* && pnpm svn:copy-folders && pnpm svn:copy-files",
		"svn:update": "svn update ./svn/trunk ./svn/assets",
		"svn:stage": "svn status ./svn/trunk ./svn/assets | sed -n 's/^![[:space:]]*//p' | while read -r f; do svn delete --force \"$f\"; done; svn add ./svn/trunk ./svn/assets --force",
		"svn:commit": "svn commit ./svn/trunk ./svn/assets -m \"Release ${npm_package_version}\"",
		"svn:tag": "svn copy https://plugins.svn.wordpress.org/am-cookies/trunk https://plugins.svn.wordpress.org/am-cookies/tags/${npm_package_version} -m \"Tagging ${npm_package_version}\"",
		"deploy": "pnpm svn:update && pnpm svn:stage && pnpm svn:commit && pnpm svn:tag",
		"clean": "pnpm pm clean && rm -rf vendor"
	},
	"cde": {
		"gettext": "am-cookies",
		"prefix": "am"
	},
	"packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
